# PostgreSQL 접속 정보
DB_HOST=192.168.0.xxx        # 회사 DB 서버 IP
DB_PORT=5432
DB_NAME=vitron_dashboard
DB_USER=vitron-dashboard
DB_PASSWORD=vi-tron805018

# Jira 연동
JIRA_HOST=vi-tron.atlassian.net
JIRA_EMAIL=your_jira_email@company.com
JIRA_TOKEN=your_jira_api_token

# 토큰 만료일(YYYY-MM-DD). Atlassian 이 만료일 조회 API 를 제공하지 않으므로
# 발급 화면에서 확인한 날짜를 직접 적는다. 만료 30일 전부터 화면 상단에 경고가 뜬다.
# 비워 두면 경고 기능이 동작하지 않는다. (토큰 최대 유효기간은 365일)
JIRA_TOKEN_EXPIRES=

# 차량 예약 알림 메일 (2026-08-25 신설)
# 다섯 개가 «모두» 채워져야 켜진다. 하나라도 비면 기능만 조용히 꺼지고
# 나머지는 그대로 돈다 — 예약 저장이 메일 때문에 막히면 안 되기 때문이다.
# 꺼져 있는지 여부는 [설정] 탭의 「차량 예약 알림 메일」 카드에서 볼 수 있다.
MAIL_HOST=smtp.daum.net
MAIL_PORT=465                 # 465 = 처음부터 SSL. STARTTLS(587) 와 다르다
MAIL_SMTP_USER=               # 접속 «아이디» (주소가 아니다)
MAIL_PASS=                    # 앱 비밀번호. 로그인 비밀번호가 아니다
MAIL_FROM=                    # 보내는 «주소». 그 계정이 가진 주소여야 한다
                              # (다음은 남의 주소를 From 에 적으면 550 으로 끊는다)
MAIL_TO=                      # 받는 사람 = 대표이사

# ⏳ 시험용 수신처 — 있으면 «나가는 메일이 전부» 이리로 온다.
#    대표이사께 갈 것(차량 예약·완료 보고·휴가/구매 신청)도,
#    직원에게 갈 것(휴가·구매 승인/반려)도 모두 포함한다.
# 🔴 개발·테스트 중에는 «반드시» 채워 둔다 (2026-08-29 사용자 지시).
#    비워 두면 시험하는 내내 진짜 대표이사께 메일이 간다.
# 🔴 운영 .env 에는 이 줄이 «없어야» 한다. 있으면 대표이사가 메일을 못 받는다.
MAIL_TO_TEST=                 # 개발·테스트 = gunholee@vi-tron.com (이건호) / 운영 = 줄째로 지운다
