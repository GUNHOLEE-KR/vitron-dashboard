# PostgreSQL 접속 정보
DB_HOST=192.168.0.xxx        # 회사 DB 서버 IP
DB_PORT=5432
DB_NAME=vitron_dashboard
DB_USER=vitron-dashboard
DB_PASSWORD=vi-tron805018

# Jira 연동
JIRA_HOST=vi-tron.atlassian.net
JIRA_EMAIL=your_jira_email@company.com
JIRA_TOKEN=your_jira_api_token

# 토큰 만료일(YYYY-MM-DD). Atlassian 이 만료일 조회 API 를 제공하지 않으므로
# 발급 화면에서 확인한 날짜를 직접 적는다. 만료 30일 전부터 화면 상단에 경고가 뜬다.
# 비워 두면 경고 기능이 동작하지 않는다. (토큰 최대 유효기간은 365일)
JIRA_TOKEN_EXPIRES=
